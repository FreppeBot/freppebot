# ╔═══════════════════════════════════════════════════════════════╗
# ║                    FREPPEBOT CONFIGURATION                     ║
# ╚═══════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────────
# AI PROVIDERS (at least one required)
# ─────────────────────────────────────────────────────────────────

# OpenRouter - Recommended! Access to many models via one API
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# OpenAI - Direct access to GPT-4, GPT-4o
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic - Direct access to Claude
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Default AI provider to use: openrouter, openai, or anthropic
DEFAULT_AI_PROVIDER=openrouter

# Default model (depends on provider)
# OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, etc.
# OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# ─────────────────────────────────────────────────────────────────
# MESSAGING PLATFORMS (at least one required)
# ─────────────────────────────────────────────────────────────────

# Discord Bot Token
# Get yours at: https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_ENABLED=true

# Telegram Bot Token
# Get yours from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true

# ─────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────

# Comma-separated list of allowed user IDs (platform-specific)
# Discord: Right-click user > Copy User ID
# Telegram: Use @userinfobot to get your ID
ALLOWED_DISCORD_USERS=
ALLOWED_TELEGRAM_USERS=

# Admin users can use dangerous plugins (shell, files)
ADMIN_DISCORD_USERS=
ADMIN_TELEGRAM_USERS=

# ─────────────────────────────────────────────────────────────────
# BOT SETTINGS
# ─────────────────────────────────────────────────────────────────

# Bot name (used in responses)
BOT_NAME=FreppeBot

# Command prefix for explicit commands
COMMAND_PREFIX=!

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────
# PLUGINS
# ─────────────────────────────────────────────────────────────────

# Enable hot-reload of plugins (recommended for development)
PLUGIN_HOT_RELOAD=true

# Disable specific plugins (comma-separated)
DISABLED_PLUGINS=

# ─────────────────────────────────────────────────────────────────
# TWITTER/X PLUGIN (Optional)
# ─────────────────────────────────────────────────────────────────

# Get your keys at: https://developer.twitter.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
