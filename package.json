{
  "name": "freppebot",
  "version": "1.0.0",
  "description": "Self-hosted AI assistant with an easy plugin system",
  "main": "src/index.js",
  "bin": {
    "freppe": "./bin/freppe.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node src/cli/setup.js",
    "setup:plugins": "node src/cli/setup.js --plugins",
    "plugin": "node src/cli/plugin-manager.js",
    "monitor": "node src/cli/monitor.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "docker:build": "docker build -t freppebot .",
    "docker:run": "docker run -d --name freppebot -v ./config.json:/app/config.json freppebot",
  },
  "keywords": [
    "ai",
    "assistant",
    "bot",
    "discord",
    "telegram",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "discord.js": "^14.16.0",
    "inquirer": "^8.2.6",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "openai": "^4.70.0",
    "sql.js": "^1.10.0",
    "telegraf": "^4.16.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
